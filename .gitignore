
# ==========================================
# 多智能体比赛专属忽略规则 (追加在文件末尾)
# ==========================================

# 1. 大模型 API Key 与本地敏感配置 (极其重要！防止 Key 泄露被盗刷)
.env
config.local.yaml
*.secret.*

# 2. 模拟运行产生的海量日志与缓存
logs/
*.log
trace/
.cache/

# 3. 实验导出的数据文件 (数据让队友通过你搭的接口或网盘拿，不要传到 Git)
data/
*.csv
*.json
*.npy
outputs/

# Keep the validated, aggregate-only source for the MGTAB audit report.
!docs/mgtab_field_audit_artifact.json

# Small, reproducibility-critical inputs for the independent-attack baseline.
# Keep bulk datasets/results ignored, but allow these exact treatment files.
!data/
data/*
!data/72agent_independent.csv
!MultiAgent4Collusion-master/scripts/twitter_simulation/align_with_real_world/system_prompt(static).json
!MultiAgent4Collusion-master/scripts/twitter_simulation/align_with_real_world/system_prompt(dynamic).json

# 4. 你的本地虚拟环境 (防止把几百MB的库传上去)
venv/
env/
.venv/
.tools/

# 5. IDE 配置文件
.vscode/
.idea/
.ipynb_checkpoints/
